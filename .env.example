# Public site URL (metadata, canonical)
NEXT_PUBLIC_SITE_URL=https://frauenkram.carstaproestler.de

# Shopify Storefront API (server-only except variant IDs if needed client-side)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10
SHOPIFY_VARIANT_ID_GUIDE=gid://shopify/ProductVariant/000000000000
SHOPIFY_VARIANT_ID_BUNDLE=gid://shopify/ProductVariant/000000000000

# Analytics (only loaded after consent)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server consent cookie signing (min. 32 characters in production)
CONSENT_COOKIE_SECRET=

# Meta Conversions API (optional – enables server forwarding)
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
META_CAPI_API_VERSION=v21.0

# Vercel deploy (GitHub Actions)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Public site URL (metadata, canonical)
NEXT_PUBLIC_SITE_URL=https://frauenkram.carstaproestler.de

# Shopify – öffentliche Store-/Variant-IDs (für Dokumentation & Fallback)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=4ea9ce-1f.myshopify.com
NEXT_PUBLIC_VARIANT_GUIDE=gid://shopify/ProductVariant/53539872670039
NEXT_PUBLIC_VARIANT_BUNDLE=gid://shopify/ProductVariant/53539872702807
NEXT_PUBLIC_AMAZON_KINDLE_URL=https://www.amazon.de/dp/B0G3XYHSMF

# Shopify Storefront API (server-only – Token via npm run shopify:bootstrap)
SHOPIFY_STORE_DOMAIN=4ea9ce-1f.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10
SHOPIFY_VARIANT_ID_GUIDE=gid://shopify/ProductVariant/53539872670039
SHOPIFY_VARIANT_ID_BUNDLE=gid://shopify/ProductVariant/53539872702807

# Shopify Dev Dashboard – Client Credentials (NUR lokal/Vercel, nie committen)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: POST /api/shopify/bootstrap mit Authorization: Bearer <secret>
SHOPIFY_BOOTSTRAP_SECRET=

# Meta Pixel (nur nach Consent `granted` – siehe ConsentBanner)
NEXT_PUBLIC_META_PIXEL_ID=

# Server consent cookie signing (min. 32 characters in production)
CONSENT_COOKIE_SECRET=

# Meta Conversions API (optional – enables server forwarding)
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
META_CAPI_API_VERSION=v21.0

# Vercel deploy (GitHub Actions)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
